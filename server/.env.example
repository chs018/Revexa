# Port the Express server listens on. Optional — defaults to 4000 if unset.
PORT=4000

# Postgres connection string (Prisma)
DATABASE_URL=

# Part B: a genuinely SEPARATE database from DATABASE_URL above — tests
# reset and seed this one, never the real/demo database. In CI (see
# .github/workflows/test.yml) this points at the ephemeral Postgres service
# container instead.
TEST_DATABASE_URL=

# Razorpay API credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Gemini API key (used by the agent, from Day 3 onward)
GEMINI_API_KEY=

# Agent tuning
# GAP 3 (rigor review): CONFIDENCE_THRESHOLD, RISK_BAND_MARGIN, and
# HIGH_VALUE_CUTOFF are all derived from scripts/ml/threshold_sweep.py, not
# picked by hand — see docs/threshold-rationale.md for the method, the
# actual sweep numbers, and an important caveat about the baseline
# classifier's weak signal on this synthetic feature set. Rerun the sweep
# after generating more data and update these three to match.
CONFIDENCE_THRESHOLD=0.65
MAX_RETRY_ATTEMPTS=3

# GAP 2: pending_review routing. A score within CONFIDENCE_THRESHOLD ±
# RISK_BAND_MARGIN is borderline; a dispute amount above HIGH_VALUE_CUTOFF
# (smallest currency unit, e.g. paise) is routed to pending_review
# regardless of score.
RISK_BAND_MARGIN=0.15
HIGH_VALUE_CUTOFF=999900

# GAP 2 (rigor review): a flat fee the acquirer charges per filed dispute,
# regardless of outcome — real chargeback economics on top of the disputed
# amount, not instead of it. Applied in /metrics and /metrics-ml as an
# addition to false-positive cost specifically (a dispute the model
# shouldn't have contested still burns this fee). See docs/threshold-rationale.md.
CHARGEBACK_FEE=1500

# GAP 2: reputational-risk section on the Dashboard. TOTAL_TXN_VOLUME is a
# synthetic total-transactions denominator for disputeRatio = disputes
# filed / TOTAL_TXN_VOLUME — set relative to your own dispute volume, not a
# real processor figure. DISPUTE_RATIO_WARNING is an explicitly
# configurable/illustrative placeholder, NOT a verified current Visa/
# Mastercard monitoring-program threshold — verify against the networks'
# current published figures before citing a specific number anywhere real.
TOTAL_TXN_VOLUME=20000
DISPUTE_RATIO_WARNING=0.01

# Review gate on POST /disputes/:id/approve. REVIEW_PIN matches the value
# ApprovalGate.jsx displays directly in the UI — not real authentication
# (no user accounts anywhere in this app), just server-side enforcement of
# the same ritual the UI already asks a human to go through, so a raw API
# call can't skip it. MIN_REVIEW_SECONDS mirrors the client's DWELL_MS —
# keep the two in sync if either changes.
REVIEW_PIN=4721
MIN_REVIEW_SECONDS=3

# PART D: business-value figures on /metrics and the Dashboard. All three
# are EXPLICITLY LABELED ASSUMPTIONS in the API response and the UI, not
# Razorpay-provided or measured figures — set them to whatever your own
# merchant's real monthly dispute volume, manual review time, and
# fully-loaded reviewer hourly cost actually are before quoting any of these
# numbers anywhere real.
ASSUMED_MONTHLY_DISPUTE_VOLUME=50
# No manual-review process exists anywhere in this app to measure a real
# per-dispute review time from — everything here was always automated —
# so, unlike avgGradedDisputeAmount/recall (both real, measured), this has
# to be an assumption. 15 minutes is a commonly-cited manual chargeback
# review estimate, not something this app has verified for your process.
ASSUMED_MINUTES_PER_MANUAL_REVIEW=15
ASSUMED_HOURLY_OPS_COST=800

# CORS origin allowed to connect (REST + Socket.io) — the client dev server.
# Defaults to http://localhost:5173 if unset. Tighten before deploying.
CLIENT_ORIGIN=http://localhost:5173
